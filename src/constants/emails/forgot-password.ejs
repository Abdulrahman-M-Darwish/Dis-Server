<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Reset your password</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #09090b;
      color: #f4f4f5;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #09090b"
    >
      <tr>
        <td align="center" style="padding: 40px 16px">
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              width: 100%;
              max-width: 600px;
              background-color: #18181b;
              border: 1px solid #27272a;
              border-radius: 18px;
              overflow: hidden;
            "
          >
            <tr>
              <td
                style="
                  padding: 36px 40px 28px;
                  background: linear-gradient(135deg, #18181b 0%, #27272a 100%);
                  border-bottom: 1px solid #3f3f46;
                "
              >
                <table
                  role="presentation"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                >
                  <tr>
                    <td
                      align="center"
                      width="40"
                      height="40"
                      style="
                        width: 40px;
                        height: 40px;
                        background-color: #8b5cf6;
                        border-radius: 10px;
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: bold;
                        line-height: 40px;
                      "
                    >
                      D
                    </td>
                    <td
                      style="
                        padding-left: 12px;
                        color: #ffffff;
                        font-size: 20px;
                        font-weight: bold;
                        letter-spacing: -0.3px;
                      "
                    >
                      DISC
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding: 40px">
                <p
                  style="
                    margin: 0 0 14px;
                    color: #a1a1aa;
                    font-size: 15px;
                    line-height: 22px;
                  "
                >
                  PASSWORD RESET
                </p>
                <p
                  style="
                    margin: 0;
                    color: #d4d4d8;
                    font-size: 16px;
                    line-height: 25px;
                  "
                >
                  We received a request to reset your DISC password. Use the
                  code below to continue.
                </p>

                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="margin: 30px 0"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        padding: 24px 16px;
                        background-color: #111113;
                        border: 1px solid #3f3f46;
                        border-radius: 12px;
                      "
                    >
                      <p
                        style="
                          margin: 0 0 10px;
                          color: #a1a1aa;
                          font-size: 12px;
                          font-weight: bold;
                          letter-spacing: 1.5px;
                        "
                      >
                        YOUR ONE-TIME CODE
                      </p>
                      <p
                        style="
                          margin: 0;
                          color: #c4b5fd;
                          font-size: 34px;
                          font-weight: bold;
                          letter-spacing: 9px;
                          line-height: 42px;
                        "
                      >
                        <%= otp %>
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0;
                    color: #d4d4d8;
                    font-size: 15px;
                    line-height: 24px;
                  "
                >
                  This code expires soon and can only be used once. Do not share
                  it with anyone.
                </p>
                <p
                  style="
                    margin: 22px 0 0;
                    color: #71717a;
                    font-size: 14px;
                    line-height: 22px;
                  "
                >
                  If you did not request a password reset, you can safely ignore
                  this email.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding: 24px 40px; border-top: 1px solid #27272a">
                <p
                  style="
                    margin: 0;
                    color: #71717a;
                    font-size: 12px;
                    line-height: 18px;
                  "
                >
                  &copy; <%= new Date().getFullYear() %> DISC. Secure account
                  recovery.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
